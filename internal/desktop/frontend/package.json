{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:dev": "vue-tsc -b && vite build --minify false --mode development",
    "lint": "eslint . --fix && prettier --write src scripts",
    "lint:check": "eslint . && prettier --check src scripts",
    "format": "prettier --write .",
    "preview": "vite preview",
    "check-contrast": "jiti scripts/check-contrast.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "screenshots": "jiti scripts/generate-screenshots.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@quasar/extras": "2.1.0",
    "@vue/devtools-api": "8.2.1",
    "@wailsio/runtime": "3.0.0",
    "pinia": "^4.1.0",
    "quasar": "2.35.2",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@pinia/testing": "2.0.2",
    "@quasar/vite-plugin": "2.0.2",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "jiti": "2.7.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "sass-embedded": "1.106.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "vite": "8.x"
      }
    }
  }
}
