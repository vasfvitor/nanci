    "story:build": "histoire build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "screenshots": "jiti scripts/generate-screenshots.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
