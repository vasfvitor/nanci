    "histoire": "1.0.0-beta.1",
    "jiti": "2.7.0",
    "playwright": "1.60.0",
    "prettier": "3.8.3",
    "sass-embedded": "1.100.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.60.0",
    "vite": "8.0.12",
