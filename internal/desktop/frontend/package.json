    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/css": "1.3.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.0",
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@pinia/testing": "1.0.3",
    "@quasar/vite-plugin": "1.12.0",
    "@types/node": "24.12.3",
    "@vitejs/plugin-vue": "6.0.6",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.4.0",
